{
  "name": "wtfgif",
  "version": "1.0.0",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpopv/wtfgif.git"
  },
  "keywords": [
    "gif",
    "wtfgif",
    "omggif",
    "encoder",
    "decoder",
    "performance",
    "compression",
    "performant",
    "fast",
    "optimized",
    "drop-in",
    "replacement",
    "typescript",
    "javascript",
    "node",
    "browser"
  ],
  "author": "Matt Popovich",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mpopv/wtfgif/issues"
  },
  "homepage": "https://github.com/mpopv/wtfgif#readme",
  "description": "A drop-in optimized replacement for omggif: - Fused LZW decode→blit - 32-bit palette, Uint32 stores - Interlace pass scheduling - Typed-array open-addressing hash for encoder",
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/omggif": "^1.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "omggif": "^1.0.10"
  }
}
